# Copy this file, rename the copy to ".env", and fill in the values.
# Ask Gabriel for the values (do not commit the real .env to GitHub).

# Firebase web config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Agora (console.agora.io > Projects > your project). Server only, no VITE_ prefix.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
