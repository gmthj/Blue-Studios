rules_version = '2';

// Firebase Storage rules (files: images and template project files).
// Like firestore.rules, Firebase checks these on its own servers for every upload and download.
//
// Every file lives in a folder named after its owner's uid, e.g. templates/{uid}/{id}/thumbnail.png,
// so "is this my file?" is just: is the uid in the path mine?
// Public files are readable only while their Firestore document says public AND not hidden
// (firestore.get below reads the document).
//
// DEV MODE (20 Oct 2026): while the team is still building, ALL of Storage is open to signed-in users
// (the DEV-OPEN block at the bottom), so teammates are not blocked. Delete it before submission.
//
// Deploy with:  firebase deploy --only storage
// Test with:    npm run test:rules

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Only the owner (an account) can upload into their own folder
    function isOwner(uid) {
      return isAccount() && request.auth.uid == uid;
    }

    // Is the Firestore item (templates/{id} or stickers/{id}) public and not hidden by an admin?
    function isPublicItem(collection, itemId) {
      let path = /databases/(default)/documents/$(collection)/$(itemId);
      return firestore.exists(path)
        && firestore.get(path).data.visibility == 'public'
        && firestore.get(path).data.status == 'active';
    }

    // Size limit in megabytes, and the file type the browser says it is
    function isImageUnder(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    // ---------- Templates ----------
    // templates/{uid}/{itemId}/thumbnail.png   (the preview picture)
    // templates/{uid}/{itemId}/project.json    (everything needed to open it in the editor)

    match /templates/{uid}/{itemId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isPublicItem('templates', itemId));

      allow create, update: if isOwner(uid) && (
        (fileName == 'thumbnail.png' && isImageUnder(2))
        || (fileName == 'project.json'
            && request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType == 'application/json'));

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Stickers ----------
    // stickers/{uid}/{itemId}/image   (PNG, GIF or WebP)

    match /stickers/{uid}/{itemId}/image {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isPublicItem('stickers', itemId));
      allow create, update: if isOwner(uid) && isImageUnder(2);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Strips (always private) ----------
    // strips/{uid}/{stripId}.jpg

    match /strips/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isOwner(uid)
        && fileName.matches('[A-Za-z0-9]+[.]jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Profile pictures ----------
    // avatars/{uid}/avatar.jpg   (made 256 x 256 in the browser before uploading, see useAuth.js)
    // Anyone signed in can see them: they are shown next to names everywhere.

    match /avatars/{uid}/avatar.jpg {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Video clips (room gallery) ----------
    // clips/{code}/{uid}/{clipId}.webm or .mp4   (see clips.js)
    // Admins can play and delete them on the admin page.
    // TODO lockdown: members' rules for clips (for now they come from the DEV block below).

    match /clips/{code}/{uid}/{fileName} {
      allow read, delete: if isAdmin();
    }

    // DEV-OPEN-START
    // ---------- DEV: ALL of Storage is open to anyone signed in (guests too) ----------
    // While we are still building, any signed-in user can read, upload, overwrite and delete ANY file,
    // in any folder (including templates/, stickers/ and strips/), so teammates are not blocked.
    // Firebase allows a request if ANY rule allows it, so this block overrides the strict rules above.
    // The tests remove this block before testing, so they still check the strict rules.
    // TODO lockdown: write real rules for each new folder (e.g. videos/), then delete this block.

    match /{allPaths=**} {
      allow read, write: if signedIn();
    }
    // DEV-OPEN-END
  }
}
