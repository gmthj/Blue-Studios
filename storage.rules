rules_version = '2';

// Firebase Storage rules (images, template project files, video clips and music).
// Like firestore.rules, Firebase checks these on its own servers for every upload and download.
//
// Every file lives in a folder named after its owner's uid, e.g. templates/{uid}/{id}/thumbnail.png,
// so "is this my file?" is just: is the uid in the path mine?
// Public files are readable only while their Firestore document says public AND not hidden
// (firestore.get below reads the document).
//
// LOCKED DOWN (phase 7): every folder has its own rule below and anything not listed is blocked.
//
// Deploy with:  firebase deploy --only storage
// Test with:    npm run test:rules

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Admins can ban an account (users/{uid}.banned = true). Banned accounts cannot upload or change files.
    function notBanned() {
      let profile = /databases/(default)/documents/users/$(request.auth.uid);
      return !firestore.exists(profile) || firestore.get(profile).data.get('banned', false) != true;
    }

    // Only the owner (an account that is not banned) can upload into their own folder
    function isOwner(uid) {
      return isAccount() && request.auth.uid == uid && notBanned();
    }

    // Is the Firestore item (templates/{id} or stickers/{id}) public and not hidden by an admin?
    function isPublicItem(collection, itemId) {
      let path = /databases/(default)/documents/$(collection)/$(itemId);
      return firestore.exists(path)
        && firestore.get(path).data.visibility == 'public'
        && firestore.get(path).data.status == 'active';
    }

    // Size limit in megabytes, and the file type the browser says it is
    function isImageUnder(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    // ---------- Templates ----------
    // templates/{uid}/{itemId}/thumbnail.png   (the preview picture)
    // templates/{uid}/{itemId}/project.json    (everything needed to open it in the editor)
    // templates/{uid}/{itemId}/card.webp       (small copy for the grids, card.png in browsers without WebP)

    match /templates/{uid}/{itemId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isPublicItem('templates', itemId));

      allow create, update: if isOwner(uid) && (
        (fileName == 'thumbnail.png' && isImageUnder(2))
        || (fileName in ['card.webp', 'card.png'] && isImageUnder(1))
        || (fileName == 'project.json'
            // Up to 50 MB: pictures uploaded in the template editor are saved inside this file
            // (as data: URLs), so a frame with photos can be big. Only the owner can upload, and only JSON.
            && request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType == 'application/json'));

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Stickers ----------
    // stickers/{uid}/{itemId}/image       (PNG, GIF or WebP)
    // stickers/{uid}/{itemId}/card.webp   (small copy for the grids, card.png in browsers without WebP)

    match /stickers/{uid}/{itemId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isPublicItem('stickers', itemId));
      allow create, update: if isOwner(uid) && (
        (fileName == 'image' && isImageUnder(2))
        || (fileName in ['card.webp', 'card.png'] && isImageUnder(1)));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Strips (always private) ----------
    // strips/{uid}/{stripId}.jpg   (a PNG, GIF or MP4 from the Share page ends with its own format)

    match /strips/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isOwner(uid)
        && (
          (fileName.matches('[A-Za-z0-9]+[.]jpg')
            && request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType == 'image/jpeg')
          || (fileName.matches('[A-Za-z0-9]+[.]png')
            && request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType == 'image/png')
          || (fileName.matches('[A-Za-z0-9]+[.]gif')
            && request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType == 'image/gif')
          || (fileName.matches('[A-Za-z0-9]+[.]mp4')
            && request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType == 'video/mp4')
        );
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Shares (a finished strip opened by its link) ----------
    // shares/{uid}/{shareId}.png | .gif | .mp4
    // Guests can make one too. The page opened by the link uses the file's own link (it has a long secret in it),
    // so it needs no rule to read. Signed in people can also read it here.

    match /shares/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && (
          (fileName.matches('[A-Za-z0-9]+[.]png') && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType == 'image/png')
          || (fileName.matches('[A-Za-z0-9]+[.]gif') && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == 'image/gif')
          || (fileName.matches('[A-Za-z0-9]+[.]mp4') && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == 'video/mp4')
        );
      allow update: if false;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ---------- Profile pictures ----------
    // avatars/{uid}/avatar.jpg   (made 256 x 256 in the browser before uploading, see useAuth.js)
    // Anyone signed in can see them: they are shown next to names everywhere.

    match /avatars/{uid}/avatar.jpg {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Am I in this room? (I have a document in rooms/{code}/members; guests count too)
    function isRoomMember(code) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/rooms/$(code)/members/$(request.auth.uid));
    }

    // ---------- Video clips (room gallery) ----------
    // clips/{code}/{uid}/{clipId}.webm or .mp4   (see clips.js)
    // Only people in the room can play them, and each person uploads into their own folder.
    // Admins can play and delete them on the admin page.

    match /clips/{code}/{uid}/{fileName} {
      allow read: if isRoomMember(code) || isAdmin();
      // resource == null: there is no file there yet, so a clip can never be replaced
      allow create: if resource == null && isRoomMember(code) && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && (
          (fileName.matches('[A-Za-z0-9]+[.]webm') && request.resource.contentType == 'video/webm')
          || (fileName.matches('[A-Za-z0-9]+[.]mp4') && request.resource.contentType == 'video/mp4')
        );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Music (Music page) ----------
    // music/{code}/mix.wav                  the finished mix, saved by anyone in the room
    // music/{code}/uploads/{uid}/{time}     a song someone uploaded, in their own folder
    // Only people in the room can use them (the Export page reads the mix). Only audio types are allowed,
    // so nothing here can be a web page or script.

    match /music/{code}/mix.wav {
      allow read: if isRoomMember(code) || isAdmin();
      allow create, update: if isRoomMember(code)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'audio/wav';
      allow delete: if isAdmin();
    }

    match /music/{code}/uploads/{uid}/{fileName} {
      allow read: if isRoomMember(code) || isAdmin();
      allow create: if resource == null && isRoomMember(code) && request.auth.uid == uid
        && fileName.matches('[0-9]+')
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp3|wav|x-wav|ogg|aac|mp4|x-m4a|m4a|webm|flac)');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Everything else is blocked (deny by default). Every folder above only accepts images, JSON, audio
    // or video, so HTML, SVG, JavaScript and XML files can never be stored.
  }
}
